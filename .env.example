# Copy this file to `.env` in the repository root and fill in your own logins.
# `.env` is ignored by git, so your passwords never end up on GitHub. Never commit it.

# NASA Earthdata, used by earthaccess to download NASA data.
# Create a free account at https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# USGS Water Data API (streamflow). Optional: works without it, a key only gives higher rate limits.
# Get a free key at https://api.waterdata.usgs.gov/signup/
API_USGS_PAT=
